// SEO OS — P0 data model
// Phase: P0 (Foundation + Intelligent Onboarding). See docs/P0_SPEC.md.
//
// Invariants encoded here:
//   Organization -> Workspace -> Website. Every tenant-owned row resolves to an Organization.
//   Unknown business facts stay NULL. No defaults that would fabricate a fact.
//   Approved BusinessContextVersion rows are immutable (trigger applied in the migration).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  SEO_LEAD
  MEMBER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TenantStatus {
  ACTIVE
  ARCHIVED
}

enum WebsiteType {
  MARKETING_SITE
  ECOMMERCE
  SAAS_PRODUCT
  PUBLISHER
  MARKETPLACE
  LOCAL_BUSINESS
  OTHER
  UNKNOWN
}

enum CmsType {
  WORDPRESS
  HUBSPOT_CMS
  WEBFLOW
  SHOPIFY
  DRUPAL
  CUSTOM
  OTHER
  UNKNOWN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum OnboardingStatus {
  IN_PROGRESS
  REVIEW
  COMPLETED
  ABANDONED
}

enum ContextStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum GoalStatus {
  DRAFT
  ACTIVE
  MET
  MISSED
  RETIRED
}

enum ApprovalStatus {
  PROPOSED
  APPROVED
  REJECTED
  ARCHIVED
}

enum CompetitorType {
  DIRECT
  ADJACENT
  SEARCH
  PUBLISHER
  AGGREGATOR
  UNKNOWN
}

enum SeoRuleSeverity {
  INFO
  WARNING
  BLOCKING
}

/// Provenance vocabulary (CLAUDE.md). P0 only ever writes USER_PROVIDED or UNKNOWN;
/// nothing in P0 infers a business fact. INFERRED never becomes canonical without
/// human confirmation.
enum Provenance {
  USER_PROVIDED
  SYSTEM_DERIVED
  INFERRED
  UNKNOWN
}

enum ConnectionProvider {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS
  HUBSPOT
  SEMRUSH
  // P2. Either Semrush or Ahrefs can supply market evidence; a snapshot always
  // records which one, because their volume and difficulty figures are computed
  // differently and are not interchangeable.
  AHREFS
  SIMILARWEB
  SCREAMING_FROG
  WORDPRESS
}

enum ConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  APPROVE
  REJECT
  RETIRE
  COMPLETE
  SIGN_IN
  // P2 opportunity lifecycle. Four verbs rather than sixteen event names:
  // entityType already says what was acted on, and the audit screen renders
  // these as badges.
  QUALIFY
  SCHEDULE
  DECLINE
  ASSIGN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Internal SEO OS user. Keyed to Supabase auth.users.id via authUserId.
/// Deliberately NOT keyed on email: email is a mutable attribute, and matching
/// on it (or on its domain) must never be a path to tenant access.
model User {
  id          String    @id @default(uuid()) @db.Uuid
  authUserId  String    @unique @map("auth_user_id") @db.Uuid
  email       String    @unique
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships        OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships OrganizationMembership[] @relation("MembershipInviter")
  onboardingSessions OnboardingSession[]
  ownedGoals         BusinessGoal[]
  ownedFacts         BrandFact[]
  ownedRules         SeoRule[]
  ownedTechContexts  TechnicalContext[]
  ownedContexts      BusinessContextVersion[] @relation("ContextOwner")
  createdContexts    BusinessContextVersion[] @relation("ContextCreator")
  approvedContexts   BusinessContextVersion[] @relation("ContextApprover")
  auditEvents        AuditEvent[]

  // P2
  assignedOwnerships KeywordPageOwnership[] @relation("OwnershipAssigner")
  ownedTopics        Topic[]                @relation("TopicOwner")
  uploadedImports    Import[]               @relation("ImportUploader")
  ownedOpportunities Opportunity[]          @relation("OpportunityOwner")

  // P3. decisions is the one that matters: a Decision's actor is a User and
  // nothing else, which is how "AI cannot approve its own recommendation" holds
  // in the schema rather than in a check somebody could forget.
  aiRuns                 AiRun[]               @relation("AiRunCreator")
  diagnosisRequests      DiagnosisRequest[]    @relation("DiagnosisRequester")
  createdDiagnoses       Diagnosis[]           @relation("DiagnosisCreator")
  reviewedDiagnoses      Diagnosis[]           @relation("DiagnosisReviewer")
  ownedRecommendations   Recommendation[]      @relation("RecommendationOwner")
  createdRecommendations Recommendation[]      @relation("RecommendationCreator")
  decisions              Decision[]            @relation("DecisionMaker")
  capturedContent        PageContentSnapshot[] @relation("ContentCapturer")

  @@map("user")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Workspace -> Website
// ---------------------------------------------------------------------------

model Organization {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  slug       String       @unique
  status     TenantStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  archivedAt DateTime?    @map("archived_at")

  memberships        OrganizationMembership[]
  workspaces         Workspace[]
  onboardingSessions OnboardingSession[]
  auditEvents        AuditEvent[]

  // P3
  aiRuns AiRun[]

  @@map("organization")
}

/// The sole source of authorization. Google authentication proves identity;
/// this row is what grants access to a tenant.
model OrganizationMembership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            Role
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?        @map("joined_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_membership")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  slug           String
  status         TenantStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  archivedAt     DateTime?    @map("archived_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websites           Website[]
  connections        Connection[]
  onboardingSessions OnboardingSession[]
  auditEvents        AuditEvent[]

  // P3
  aiRuns AiRun[]

  @@unique([organizationId, slug])
  @@map("workspace")
}

/// The primary SEO operating entity.
/// normalizedDomain is unique per workspace. Declared as a plain @@unique so Prisma
/// owns it: a partial index (WHERE archived_at IS NULL) cannot be expressed in the
/// schema, and Prisma's drift detection would try to drop it on the next migration.
/// Known limitation: archiving a website reserves its domain within that workspace.
/// P0 has no archive path in the UI, so this is not reachable in the prototype.
model Website {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  name               String?
  domain             String
  normalizedDomain   String             @map("normalized_domain")
  canonicalUrl       String?            @map("canonical_url")
  websiteType        WebsiteType?       @map("website_type")
  cmsType            CmsType?           @map("cms_type")
  primaryMarket      String?            @map("primary_market")
  primaryLanguage    String?            @map("primary_language")
  timezone           String?
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  /// Synthetic demo data lives here. An explicit flag rather than a naming
  /// convention: the DEMO DATA badge is a correctness guarantee, and inferring it
  /// from a slug would fail silently the moment someone renames something.
  isDemo             Boolean            @default(false) @map("is_demo")
  status             TenantStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  archivedAt         DateTime?          @map("archived_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessContext    BusinessContext?
  goals              BusinessGoal[]
  brandFacts         BrandFact[]
  competitors        Competitor[]
  seoRules           SeoRule[]
  technicalContext   TechnicalContext?
  connections        Connection[]
  onboardingSessions OnboardingSession[]
  auditEvents        AuditEvent[]

  // P1
  pages           Page[]
  queries         Query[]
  gscMetrics      GscMetricDaily[]
  ga4Metrics      Ga4LandingPageMetricDaily[]
  sourceSnapshots SourceSnapshot[]
  syncRuns        SyncRun[]
  sitemaps        Sitemap[]
  signals         Signal[]

  // P2
  keywords            Keyword[]
  keywordMetrics      KeywordMetricsSnapshot[]
  rankingSnapshots    RankingSnapshot[]
  keywordOwnerships   KeywordPageOwnership[]
  topics              Topic[]
  competitorSnapshots CompetitorKeywordSnapshot[]
  imports             Import[]
  opportunities       Opportunity[]

  // P3
  aiRuns            AiRun[]
  evidencePackages  EvidencePackage[]
  diagnosisRequests DiagnosisRequest[]
  diagnoses         Diagnosis[]
  recommendations   Recommendation[]
  decisions         Decision[]
  contentSnapshots  PageContentSnapshot[]

  @@unique([workspaceId, normalizedDomain])
  @@index([workspaceId])
  @@map("website")
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

/// websiteId is nullable by necessity: the session exists before step 1 creates
/// the Website, and must be resumable in that window. Set once step 1 commits.
model OnboardingSession {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  websiteId       String?          @map("website_id") @db.Uuid
  currentStep     String           @map("current_step")
  status          OnboardingStatus @default(IN_PROGRESS)
  answersJson     Json             @default("{}") @map("answers_json")
  startedByUserId String           @map("started_by_user_id") @db.Uuid
  startedAt       DateTime         @default(now()) @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website       Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  startedByUser User         @relation(fields: [startedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@map("onboarding_session")
}

// ---------------------------------------------------------------------------
// Business Context (immutable approved versions)
// ---------------------------------------------------------------------------

model BusinessContext {
  id                       String   @id @default(uuid()) @db.Uuid
  websiteId                String   @unique @map("website_id") @db.Uuid
  currentApprovedVersionId String?  @unique @map("current_approved_version_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  website                Website                  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  currentApprovedVersion BusinessContextVersion?  @relation("CurrentApproved", fields: [currentApprovedVersionId], references: [id], onDelete: SetNull)
  versions               BusinessContextVersion[] @relation("ContextVersions")

  @@map("business_context")
}

/// Immutable once status = APPROVED. Enforced at three layers:
///   1. no service-layer update path for approved rows
///   2. a BEFORE UPDATE OR DELETE trigger (see migration)
///   3. integration tests
/// Editing approved context creates a new DRAFT with version_number + 1.
model BusinessContextVersion {
  id                String        @id @default(uuid()) @db.Uuid
  businessContextId String        @map("business_context_id") @db.Uuid
  versionNumber     Int           @map("version_number")
  status            ContextStatus @default(DRAFT)

  companySummary       String?  @map("company_summary")
  productService       String?  @map("product_service")
  businessModel        String?  @map("business_model")
  primaryCustomer      String?  @map("primary_customer")
  buyerRoles           String[] @map("buyer_roles")
  primaryMarket        String?  @map("primary_market")
  languages            String[]
  primaryConversion    String?  @map("primary_conversion")
  secondaryConversions String[] @map("secondary_conversions")
  businessPriorities   String[] @map("business_priorities")
  seoPriorities        String[] @map("seo_priorities")
  competitorSummary    String?  @map("competitor_summary")
  differentiators      String[]
  brandVoice           String?  @map("brand_voice")
  priorityTopics       String[] @map("priority_topics")
  avoidTopics          String[] @map("avoid_topics")
  approvedClaims       String[] @map("approved_claims")
  prohibitedClaims     String[] @map("prohibited_claims")

  ownerUserId      String?   @map("owner_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  approvedAt       DateTime? @map("approved_at")

  businessContext BusinessContext  @relation("ContextVersions", fields: [businessContextId], references: [id], onDelete: Cascade)
  currentFor      BusinessContext? @relation("CurrentApproved")
  owner           User?            @relation("ContextOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("ContextCreator", fields: [createdByUserId], references: [id])
  approvedBy      User?            @relation("ContextApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  // P3. A package records which approved context version it reasoned from, so a
  // diagnosis stays readable after the context is revised.
  evidencePackages EvidencePackage[]

  @@unique([businessContextId, versionNumber])
  @@map("business_context_version")
}

// ---------------------------------------------------------------------------
// Governance entities
// ---------------------------------------------------------------------------

/// baseline stays NULL when unknown — never zero, never a placeholder.
model BusinessGoal {
  id                String     @id @default(uuid()) @db.Uuid
  websiteId         String     @map("website_id") @db.Uuid
  title             String
  description       String?
  periodStart       DateTime?  @map("period_start") @db.Date
  periodEnd         DateTime?  @map("period_end") @db.Date
  businessObjective String?    @map("business_objective")
  seoOutcome        String?    @map("seo_outcome")
  primaryMetric     String?    @map("primary_metric")
  leadingIndicator  String?    @map("leading_indicator")
  baseline          Decimal?   @db.Decimal(18, 4)
  baselineSource    String?    @map("baseline_source")
  baselineDate      DateTime?  @map("baseline_date") @db.Date
  ownerUserId       String?    @map("owner_user_id") @db.Uuid
  status            GoalStatus @default(DRAFT)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  archivedAt        DateTime?  @map("archived_at")

  website       Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  owner         User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]

  // P2. What a goal is attached to, so an opportunity can say which business
  // outcome it serves rather than being ranked in a vacuum.
  keywords Keyword[]
  topics   Topic[]

  @@index([websiteId])
  @@map("business_goal")
}

/// Only APPROVED facts are canonical. sourceUrl is nullable and never fabricated.
model BrandFact {
  id             String         @id @default(uuid()) @db.Uuid
  websiteId      String         @map("website_id") @db.Uuid
  category       String
  factKey        String         @map("fact_key")
  value          String
  source         Provenance     @default(USER_PROVIDED)
  sourceUrl      String?        @map("source_url")
  approvalStatus ApprovalStatus @default(PROPOSED) @map("approval_status")
  ownerUserId    String?        @map("owner_user_id") @db.Uuid
  verifiedAt     DateTime?      @map("verified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  archivedAt     DateTime?      @map("archived_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@map("brand_fact")
}

/// P0 does not scrape or auto-classify competitors. type defaults to UNKNOWN.
model Competitor {
  id               String         @id @default(uuid()) @db.Uuid
  websiteId        String         @map("website_id") @db.Uuid
  name             String
  domain           String?
  normalizedDomain String?        @map("normalized_domain")
  type             CompetitorType @default(UNKNOWN)
  providedByUser   Boolean        @default(true) @map("provided_by_user")
  source           Provenance     @default(USER_PROVIDED)
  notes            String?
  status           TenantStatus   @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  archivedAt       DateTime?      @map("archived_at")

  website          Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keywordSnapshots CompetitorKeywordSnapshot[]
  opportunities    Opportunity[]

  @@index([websiteId])
  @@map("competitor")
}

model SeoRule {
  id            String          @id @default(uuid()) @db.Uuid
  websiteId     String          @map("website_id") @db.Uuid
  category      String
  rule          String
  severity      SeoRuleSeverity @default(INFO)
  appliesTo     String?         @map("applies_to")
  ownerUserId   String?         @map("owner_user_id") @db.Uuid
  effectiveFrom DateTime?       @map("effective_from") @db.Date
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  archivedAt    DateTime?       @map("archived_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  // P3. A BLOCKING rule can stop a recommendation, and an override records which
  // rule was set aside and by whom.
  blockedRecommendations Recommendation[]
  overridingDecisions    Decision[]       @relation("DecisionRuleOverride")

  @@index([websiteId])
  @@map("seo_rule")
}

/// Shell only. P0 must not infer crawl, indexation, or technical health.
model TechnicalContext {
  id                 String   @id @default(uuid()) @db.Uuid
  websiteId          String   @unique @map("website_id") @db.Uuid
  cms                CmsType?
  hostingNotes       String?  @map("hosting_notes")
  knownMigrations    String?  @map("known_migrations")
  knownConstraints   String?  @map("known_constraints")
  stagingAvailable   Boolean? @map("staging_available")
  developerContact   String?  @map("developer_contact")
  publicationProcess String?  @map("publication_process")
  technicalNotes     String?  @map("technical_notes")
  ownerUserId        String?  @map("owner_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@map("technical_context")
}

// ---------------------------------------------------------------------------
// Connections
// ---------------------------------------------------------------------------

/// credentialReference is a pointer into a secret manager — never a credential.
/// No column on this model may ever hold a token, key, or password.
model Connection {
  id                  String             @id @default(uuid()) @db.Uuid
  workspaceId         String             @map("workspace_id") @db.Uuid
  websiteId           String?            @map("website_id") @db.Uuid
  provider            ConnectionProvider
  status              ConnectionStatus   @default(NOT_CONNECTED)
  credentialReference String?            @map("credential_reference")
  lastError           String?            @map("last_error")
  connectedAt         DateTime?          @map("connected_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // P1: property selection is a deliberate second step. Authorising an account is
  // not the same as choosing which property SEO OS reads, and a site with several
  // properties must not have one guessed for it.
  externalPropertyId   String?   @map("external_property_id")
  externalPropertyName String?   @map("external_property_name")
  propertySelectedAt   DateTime? @map("property_selected_at")
  // Advanced only by a SUCCEEDED sync. A failed run must not look like fresh data.
  lastSyncedAt         DateTime? @map("last_synced_at")
  latestDataDate       DateTime? @map("latest_data_date") @db.Date

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website   Website?  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  credential      Credential?
  sourceSnapshots SourceSnapshot[]
  syncRuns        SyncRun[]
  gscMetrics      GscMetricDaily[]
  ga4Metrics      Ga4LandingPageMetricDaily[]

  // P2
  keywordMetrics   KeywordMetricsSnapshot[]
  rankingSnapshots RankingSnapshot[]

  @@unique([websiteId, provider])
  @@index([workspaceId])
  @@map("connection")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Snapshots pass through a redaction denylist before being written.
/// Tokens, keys, passwords, and credential references must never appear here.
model AuditEvent {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  workspaceId        String?     @map("workspace_id") @db.Uuid
  websiteId          String?     @map("website_id") @db.Uuid
  actorUserId        String?     @map("actor_user_id") @db.Uuid
  entityType         String      @map("entity_type")
  entityId           String      @map("entity_id")
  action             AuditAction
  beforeSnapshotJson Json?       @map("before_snapshot_json")
  afterSnapshotJson  Json?       @map("after_snapshot_json")
  createdAt          DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  website      Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([websiteId, createdAt])
  @@map("audit_event")
}

// ===========================================================================
// P1 — First-Party Search & Analytics Intelligence
//
// Invariants encoded here:
//   Every metric row names the connection and snapshot it came from, so any
//     number on screen can be traced to a specific API response.
//   Unique keys enforce the documented grain, so a retried sync overwrites
//     rather than duplicates.
//   Unavailable values stay NULL. A GA4 property with no ecommerce reports 0
//     revenue; storing that 0 would be indistinguishable from a measured zero.
// ===========================================================================

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum SyncType {
  GSC_METRICS
  GA4_METRICS
  SITEMAP_FETCH
  /// Semrush organic positions, fetched live (P2_SPEC §7 LIVE API MODE). One
  /// report carries both rankings and keyword metrics, so it is one sync type
  /// rather than two.
  SEMRUSH_ORGANIC
  /// The same for Ahrefs. A separate value because a run records which vendor
  /// was asked; one shared type would make "did Ahrefs pull today" unanswerable.
  AHREFS_ORGANIC
}

enum SearchType {
  WEB
  IMAGE
  VIDEO
  NEWS
  DISCOVER
}

/// Where a Page was first observed. A page known only from a sitemap has been
/// claimed by the site; a page known from Search Console has been seen by Google.
enum PageSource {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS
  SITEMAP
  MANUAL
}

enum PageType {
  HOME
  COMMERCIAL
  BLOG_POST
  CATEGORY
  LANDING
  DOCUMENTATION
  OTHER
  UNKNOWN
}

enum SitemapFetchStatus {
  NEVER_FETCHED
  FETCHING
  SUCCEEDED
  FAILED
}

enum SignalType {
  TRAFFIC_DECLINE
  TRAFFIC_GROWTH
  IMPRESSION_GROWTH
  CTR_OPPORTUNITY
  STRIKING_DISTANCE
  PAGE_WINNER
  PAGE_LOSER
  QUERY_WINNER
  QUERY_LOSER
  DATA_FRESHNESS_RISK
}

enum SignalStatus {
  DETECTED
  REVIEWED
  DISMISSED
  PROMOTED
  RESOLVED
}

enum SignalSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum EvidenceType {
  METRIC_COMPARISON
  THRESHOLD
  SOURCE_FRESHNESS
  // P2
  RANKING_OBSERVATION
  KEYWORD_METRIC
  OWNERSHIP_STATE
  COMPETITOR_OVERLAP
  GOAL_ALIGNMENT
}

/// Encrypted OAuth material for a Connection.
///
/// Never read by UI code and never returned by a service. Connection points at
/// this row; the row holds ciphertext. keyVersion allows rotation without
/// re-authorising every connection.
model Credential {
  id               String             @id @default(uuid()) @db.Uuid
  connectionId     String             @unique @map("connection_id") @db.Uuid
  provider         ConnectionProvider
  encryptedPayload String             @map("encrypted_payload")
  keyVersion       Int                @default(1) @map("key_version")
  scopes           String[]
  expiresAt        DateTime?          @map("expires_at")
  rotatedAt        DateTime?          @map("rotated_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("credential")
}

/// A URL on the website.
///
/// sitemapPresent means the site claims the URL exists. It is never rendered as
/// "indexed" — that would be a claim about Google a sitemap cannot support.
model Page {
  id              String       @id @default(uuid()) @db.Uuid
  websiteId       String       @map("website_id") @db.Uuid
  url             String
  normalizedUrl   String       @map("normalized_url")
  path            String
  hostname        String
  protocol        String
  pageType        PageType     @default(UNKNOWN) @map("page_type")
  contentType     String?      @map("content_type")
  sourceFirstSeen PageSource   @map("source_first_seen")
  firstSeenAt     DateTime     @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at")
  sitemapPresent  Boolean      @default(false) @map("sitemap_present")
  status          TenantStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  archivedAt      DateTime?    @map("archived_at")

  website    Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  gscMetrics GscMetricDaily[]
  ga4Metrics Ga4LandingPageMetricDaily[]
  signals    Signal[]

  // P2
  rankingSnapshots    RankingSnapshot[]
  keywordOwnerships   KeywordPageOwnership[]
  topicPages          TopicPage[]
  pillarForTopics     Topic[]                @relation("TopicPillarPage")
  commercialForTopics Topic[]                @relation("TopicCommercialPage")
  opportunities       Opportunity[]

  // P3
  contentSnapshots PageContentSnapshot[]
  recommendations  Recommendation[]

  @@unique([websiteId, normalizedUrl])
  @@index([websiteId, lastSeenAt])
  @@map("page")
}

model Query {
  id              String   @id @default(uuid()) @db.Uuid
  websiteId       String   @map("website_id") @db.Uuid
  query           String
  normalizedQuery String   @map("normalized_query")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  website    Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  gscMetrics GscMetricDaily[]
  signals    Signal[]

  @@unique([websiteId, normalizedQuery])
  @@index([websiteId, lastSeenAt])
  @@map("query")
}

/// Search Console metrics at the documented grain.
///
/// country and device are stored as explicit "ALL" sentinels in P1: ingesting the
/// full breakdown multiplies row count by roughly fifty and would not fit the
/// current database tier. The columns and the unique key stay at the documented
/// grain, so broadening later is a configuration change plus a backfill rather
/// than a migration. Data Health states which breakdown is being ingested.
///
/// ctr and position are stored as reported per row but are NEVER averaged across
/// rows: aggregation recomputes CTR from summed clicks and impressions, and
/// weights position by impressions.
model GscMetricDaily {
  id                 String     @id @default(uuid()) @db.Uuid
  websiteId          String     @map("website_id") @db.Uuid
  pageId             String     @map("page_id") @db.Uuid
  queryId            String     @map("query_id") @db.Uuid
  date               DateTime   @db.Date
  country            String     @default("ALL")
  device             String     @default("ALL")
  searchType         SearchType @default(WEB) @map("search_type")
  clicks             Int
  impressions        Int
  ctr                Decimal?   @db.Decimal(9, 6)
  position           Decimal?   @db.Decimal(7, 3)
  sourceConnectionId String     @map("source_connection_id") @db.Uuid
  sourceSnapshotId   String?    @map("source_snapshot_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  website          Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page             Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  queryEntity      Query           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  sourceConnection Connection      @relation(fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  sourceSnapshot   SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@unique([websiteId, date, pageId, queryId, country, device, searchType])
  @@index([websiteId, date])
  @@index([pageId, date])
  @@index([queryId, date])
  @@map("gsc_metric_daily")
}

/// GA4 landing-page metrics.
///
/// Every metric is nullable. GA4 returns 0 for a property that does not measure
/// something, and a stored 0 cannot be told apart from a measured zero — so an
/// unmeasured metric stays NULL and the interface says "Not available".
model Ga4LandingPageMetricDaily {
  id                 String   @id @default(uuid()) @db.Uuid
  websiteId          String   @map("website_id") @db.Uuid
  pageId             String   @map("page_id") @db.Uuid
  date               DateTime @db.Date
  sessions           Int?
  engagedSessions    Int?     @map("engaged_sessions")
  users              Int?
  newUsers           Int?     @map("new_users")
  keyEvents          Int?     @map("key_events")
  conversions        Int?
  revenue            Decimal? @db.Decimal(18, 4)
  sourceConnectionId String   @map("source_connection_id") @db.Uuid
  sourceSnapshotId   String?  @map("source_snapshot_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  website          Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page             Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sourceConnection Connection      @relation(fields: [sourceConnectionId], references: [id], onDelete: Cascade)
  sourceSnapshot   SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@unique([websiteId, date, pageId])
  @@index([websiteId, date])
  @@map("ga4_landing_page_metric_daily")
}

/// What a provider actually returned.
///
/// objectStorageKey is nullable and unset in P1: retaining raw payloads needs a
/// bucket that does not exist yet. The column keeps the design honest rather than
/// inventing a pointer to nothing. Metadata passes through the redaction denylist;
/// a snapshot must never contain a token.
model SourceSnapshot {
  id               String             @id @default(uuid()) @db.Uuid
  websiteId        String             @map("website_id") @db.Uuid
  connectionId     String             @map("connection_id") @db.Uuid
  provider         ConnectionProvider
  capturedAt       DateTime           @default(now()) @map("captured_at")
  periodStart      DateTime?          @map("period_start") @db.Date
  periodEnd        DateTime?          @map("period_end") @db.Date
  objectStorageKey String?            @map("object_storage_key")
  checksum         String?
  metadataJson     Json?              @map("metadata_json")
  createdAt        DateTime           @default(now()) @map("created_at")

  website    Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  gscMetrics GscMetricDaily[]
  ga4Metrics Ga4LandingPageMetricDaily[]

  // P2
  keywordMetrics      KeywordMetricsSnapshot[]
  rankingSnapshots    RankingSnapshot[]
  competitorSnapshots CompetitorKeywordSnapshot[]

  @@index([websiteId, capturedAt])
  @@map("source_snapshot")
}

/// One attempt to pull data for one period.
///
/// The idempotency key is unique per connection, so retrying a window cannot
/// create a second run. A FAILED or PARTIAL run must not advance the connection's
/// freshness: "no data since Tuesday" and "everything is fine" have to stay
/// distinguishable.
model SyncRun {
  id              String             @id @default(uuid()) @db.Uuid
  websiteId       String             @map("website_id") @db.Uuid
  connectionId    String             @map("connection_id") @db.Uuid
  provider        ConnectionProvider
  syncType        SyncType           @map("sync_type")
  status          SyncStatus         @default(QUEUED)
  periodStart     DateTime?          @map("period_start") @db.Date
  periodEnd       DateTime?          @map("period_end") @db.Date
  startedAt       DateTime?          @map("started_at")
  finishedAt      DateTime?          @map("finished_at")
  recordsReceived Int                @default(0) @map("records_received")
  recordsWritten  Int                @default(0) @map("records_written")
  recordsSkipped  Int                @default(0) @map("records_skipped")
  errorCode       String?            @map("error_code")
  errorSummary    String?            @map("error_summary")
  idempotencyKey  String             @map("idempotency_key")
  createdAt       DateTime           @default(now()) @map("created_at")

  website    Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, idempotencyKey])
  @@index([websiteId, createdAt])
  @@map("sync_run")
}

model Sitemap {
  id                    String             @id @default(uuid()) @db.Uuid
  websiteId             String             @map("website_id") @db.Uuid
  url                   String
  fetchStatus           SitemapFetchStatus @default(NEVER_FETCHED) @map("fetch_status")
  lastFetchedAt         DateTime?          @map("last_fetched_at")
  lastSuccessfulFetchAt DateTime?          @map("last_successful_fetch_at")
  urlCount              Int?               @map("url_count")
  lastError             String?            @map("last_error")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, url])
  @@map("sitemap")
}

/// An observation, never a diagnosis.
///
/// headline and summary are built from templates containing no causal vocabulary,
/// and a test asserts none matches /because|caused by|due to/. Explaining why a
/// change happened is P3 work, and claiming it here would be the exact failure the
/// product exists to avoid.
model Signal {
  id                    String         @id @default(uuid()) @db.Uuid
  websiteId             String         @map("website_id") @db.Uuid
  type                  SignalType
  status                SignalStatus   @default(DETECTED)
  severity              SignalSeverity @default(INFO)
  pageId                String?        @map("page_id") @db.Uuid
  queryId               String?        @map("query_id") @db.Uuid
  detectedAt            DateTime       @default(now()) @map("detected_at")
  currentPeriodStart    DateTime       @map("current_period_start") @db.Date
  currentPeriodEnd      DateTime       @map("current_period_end") @db.Date
  comparisonPeriodStart DateTime       @map("comparison_period_start") @db.Date
  comparisonPeriodEnd   DateTime       @map("comparison_period_end") @db.Date
  score                 Decimal?       @db.Decimal(9, 4)
  scoringModelVersion   String         @map("scoring_model_version")
  headline              String
  summary               String?
  evidenceJson          Json?          @map("evidence_json")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  resolvedAt            DateTime?      @map("resolved_at")

  website       Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page          Page?            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  queryRef      Query?           @relation(fields: [queryId], references: [id], onDelete: Cascade)
  evidence      SignalEvidence[]
  opportunities Opportunity[]

  // P3. A signal is one of the two things a diagnosis can be asked about.
  diagnosisRequests DiagnosisRequest[]
  diagnoses         Diagnosis[]

  // Identity is enforced by a raw unique index with NULLS NOT DISTINCT
  // (see migration 20260902030000). Prisma cannot express that, and the default
  // NULLS DISTINCT behaviour would let a signal with no page and no query — a
  // freshness risk — insert a duplicate on every detection run.
  @@index([websiteId, status, severity])
  @@index([websiteId, type, currentPeriodStart])
  @@map("signal")
}

/// The persisted numbers a signal was derived from.
/// Every signal must be explainable without recomputing anything.
model SignalEvidence {
  id               String       @id @default(uuid()) @db.Uuid
  signalId         String       @map("signal_id") @db.Uuid
  evidenceType     EvidenceType @map("evidence_type")
  sourceEntityType String       @map("source_entity_type")
  sourceEntityId   String       @map("source_entity_id")
  metricKey        String       @map("metric_key")
  currentValue     Decimal?     @map("current_value") @db.Decimal(18, 4)
  previousValue    Decimal?     @map("previous_value") @db.Decimal(18, 4)
  periodStart      DateTime?    @map("period_start") @db.Date
  periodEnd        DateTime?    @map("period_end") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at")

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@map("signal_evidence")
}

// ---------------------------------------------------------------------------
// P2 — Market, keyword and opportunity intelligence
// ---------------------------------------------------------------------------

/// Where a keyword sits on the buying journey.
enum KeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
  LOCAL
  MIXED
  UNKNOWN
}

/// Deliberately separate from the canonical Provenance enum.
///
/// CLAUDE.md fixes the data-provenance vocabulary (USER_PROVIDED, SYSTEM_DERIVED,
/// INFERRED, UNKNOWN) and P2_SPEC §9 names a different set for intent. They answer
/// different questions — where did this row come from, versus who decided what
/// this keyword means — so merging them would weaken both.
enum IntentProvenance {
  USER_PROVIDED
  PROVIDER_PROVIDED
  SYSTEM_CLASSIFIED
  UNKNOWN
}

enum OwnershipType {
  PRIMARY
  SECONDARY
  EXPERIMENTAL
  UNKNOWN
}

enum OwnershipStatus {
  ACTIVE
  REVIEW_NEEDED
  RETIRED
}

/// Observations about ownership, never diagnoses. The names end in CANDIDATE
/// where a diagnosis would be tempting; confirming cannibalization belongs to P3.
enum OwnershipCandidateType {
  NO_OWNING_PAGE
  RANKING_URL_DIVERGENCE
  RANKING_URL_SWITCH
  MULTIPLE_RANKING_PAGES
  CANNIBALIZATION_CANDIDATE
}

enum TopicCoverage {
  UNMAPPED
  PLANNED
  PARTIAL
  COVERED
  OVERLAPPING
  UNKNOWN
}

enum TopicAuthority {
  WEAK
  DEVELOPING
  STRONG
  UNKNOWN
}

enum TopicPageRole {
  PILLAR
  SUPPORTING
  COMMERCIAL
  UTILITY
  UNKNOWN
}

enum OpportunityType {
  COMMERCIAL_RANKING
  KEYWORD_OWNERSHIP
  CTR
  TOPIC_GAP
  COMPETITOR_GAP
  CONTENT_REFRESH
  NO_OWNING_PAGE
  KEYWORD_GAP
  WEAK_OWNING_PAGE
  RANKING_URL_DIVERGENCE
}

enum OpportunityStatus {
  IDENTIFIED
  QUALIFIED
  SCHEDULED
  IN_PROGRESS
  DECLINED
  COMPLETED
  ARCHIVED
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum ImportStatus {
  UPLOADED
  PARSING
  VALIDATED
  PREVIEWED
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportSource {
  SEMRUSH_POSITIONS
  SEMRUSH_KEYWORD_OVERVIEW
  SEMRUSH_COMPETITORS
  AHREFS_POSITIONS
  AHREFS_KEYWORD_OVERVIEW
  AHREFS_COMPETITORS
  MANUAL_CSV
}

/// A search term this website cares about, in one market.
///
/// Identity includes locale, language and market because there is no single global
/// keyword: "payroll software" in the Philippines and in the United States have
/// different volumes, different competitors and different money behind them.
/// Collapsing them would produce one row describing neither.
///
/// All three locale columns are non-null with defaults. A NULL does not compare
/// equal to another NULL in a Postgres unique index, so nullable locale columns
/// would quietly permit duplicates — the trap that produced duplicate signals in
/// P1, designed out here rather than indexed around a second time.
model Keyword {
  id                String           @id @default(uuid()) @db.Uuid
  websiteId         String           @map("website_id") @db.Uuid
  keyword           String
  normalizedKeyword String           @map("normalized_keyword")
  locale            String           @default("en-PH")
  language          String           @default("en")
  market            String           @default("PH")
  intent            KeywordIntent    @default(UNKNOWN)
  intentProvenance  IntentProvenance @default(UNKNOWN) @map("intent_provenance")
  /// 0–5, set by a person. Feeds the opportunity score, so it is never guessed.
  businessRelevance Int?             @map("business_relevance")
  commercialValue   Int?             @map("commercial_value")
  /// The goal this keyword serves, stated by a person. Never inferred: a
  /// keyword is not evidence of a business intention, and guessing the link
  /// would put weight on the score that nobody put there.
  businessGoalId    String?          @map("business_goal_id") @db.Uuid
  status            TenantStatus     @default(ACTIVE)
  firstSeenAt       DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime         @default(now()) @map("last_seen_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  archivedAt        DateTime?        @map("archived_at")

  website             Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  businessGoal        BusinessGoal?               @relation(fields: [businessGoalId], references: [id], onDelete: SetNull)
  metricSnapshots     KeywordMetricsSnapshot[]
  rankingSnapshots    RankingSnapshot[]
  ownerships          KeywordPageOwnership[]
  topicKeywords       TopicKeyword[]
  competitorSnapshots CompetitorKeywordSnapshot[]
  opportunities       Opportunity[]
  recommendations     Recommendation[]

  @@unique([websiteId, normalizedKeyword, locale, language, market])
  @@index([websiteId, lastSeenAt])
  @@index([websiteId, intent])
  @@map("keyword")
}

/// Volume and difficulty as they stood on a date, according to one provider.
///
/// Never mutable fields on Keyword: these change, and a prioritization built on
/// the current volume with no history cannot explain why it ranked something
/// highly last quarter.
model KeywordMetricsSnapshot {
  id                 String             @id @default(uuid()) @db.Uuid
  websiteId          String             @map("website_id") @db.Uuid
  keywordId          String             @map("keyword_id") @db.Uuid
  capturedAt         DateTime           @map("captured_at") @db.Date
  searchVolume       Int?               @map("search_volume")
  /// Provider difficulty. Stored WITH its provider and never compared across
  /// them: a Semrush KD of 40 and an Ahrefs KD of 40 are not the same claim.
  keywordDifficulty  Decimal?           @map("keyword_difficulty") @db.Decimal(6, 2)
  cpc                Decimal?           @db.Decimal(12, 4)
  currency           String?
  sourceProvider     ConnectionProvider @map("source_provider")
  sourceConnectionId String?            @map("source_connection_id") @db.Uuid
  sourceSnapshotId   String?            @map("source_snapshot_id") @db.Uuid
  sourceImportId     String?            @map("source_import_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")

  website          Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          Keyword         @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  sourceConnection Connection?     @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  sourceSnapshot   SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  sourceImport     Import?         @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([keywordId, capturedAt, sourceProvider])
  @@index([websiteId, capturedAt])
  @@map("keyword_metrics_snapshot")
}

/// Where a keyword ranked at a moment, according to a named provider.
///
/// Append-only. pageId is null when the ranking URL is not in our Page inventory,
/// and that null is information: it usually means Google is ranking something we
/// do not know about, which is worth surfacing rather than papering over by
/// inventing a Page.
model RankingSnapshot {
  id                 String             @id @default(uuid()) @db.Uuid
  websiteId          String             @map("website_id") @db.Uuid
  keywordId          String             @map("keyword_id") @db.Uuid
  pageId             String?            @map("page_id") @db.Uuid
  capturedAt         DateTime           @map("captured_at") @db.Date
  position           Decimal?           @db.Decimal(7, 2)
  /// Only when the provider supplied it. Deriving it from our own previous
  /// snapshot would mix two different claims under one column.
  previousPosition   Decimal?           @map("previous_position") @db.Decimal(7, 2)
  rankingUrl         String?            @map("ranking_url")
  rankingType        String?            @map("ranking_type")
  serpFeaturesJson   Json?              @map("serp_features_json")
  sourceProvider     ConnectionProvider @map("source_provider")
  sourceConnectionId String?            @map("source_connection_id") @db.Uuid
  sourceSnapshotId   String?            @map("source_snapshot_id") @db.Uuid
  sourceImportId     String?            @map("source_import_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")

  website          Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          Keyword         @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  page             Page?           @relation(fields: [pageId], references: [id], onDelete: SetNull)
  sourceConnection Connection?     @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  sourceSnapshot   SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  sourceImport     Import?         @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([keywordId, capturedAt, sourceProvider])
  @@index([websiteId, capturedAt])
  @@index([pageId, capturedAt])
  @@map("ranking_snapshot")
}

/// The page a team INTENDS to own a keyword.
///
/// Distinct from wherever Google currently ranks, and the gap between the two is
/// the most useful thing P2 knows. One active PRIMARY owner per keyword and market
/// is enforced by a partial unique index in migration 20260903000100 — Postgres
/// can express unique WHERE status = ACTIVE AND ownership_type = PRIMARY, which
/// application code could always be talked out of.
model KeywordPageOwnership {
  id               String          @id @default(uuid()) @db.Uuid
  websiteId        String          @map("website_id") @db.Uuid
  keywordId        String          @map("keyword_id") @db.Uuid
  pageId           String          @map("page_id") @db.Uuid
  ownershipType    OwnershipType   @default(PRIMARY) @map("ownership_type")
  status           OwnershipStatus @default(ACTIVE)
  market           String          @default("PH")
  language         String          @default("en")
  locale           String          @default("en-PH")
  assignedByUserId String?         @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime        @default(now()) @map("assigned_at")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  archivedAt       DateTime?       @map("archived_at")

  website    Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword    Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("OwnershipAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([websiteId, status])
  @@index([keywordId, status])
  @@index([pageId])
  @@map("keyword_page_ownership")
}

/// A subject the business wants to be known for. Authored, never inferred.
///
/// P2 has no clustering algorithm and should not pretend to: a cluster that is 80%
/// right produces a topic map nobody trusts and everybody re-checks by hand.
model Topic {
  id                          String         @id @default(uuid()) @db.Uuid
  websiteId                   String         @map("website_id") @db.Uuid
  name                        String
  slug                        String
  description                 String?
  /// The words a customer uses, not the words the business uses.
  customerLanguage            String?        @map("customer_language")
  businessOutcome             String?        @map("business_outcome")
  parentTopicId               String?        @map("parent_topic_id") @db.Uuid
  pillarPageId                String?        @map("pillar_page_id") @db.Uuid
  /// Separate from the pillar: the page that explains a topic is rarely the page
  /// that sells it.
  commercialDestinationPageId String?        @map("commercial_destination_page_id") @db.Uuid
  coverageStatus              TopicCoverage  @default(UNKNOWN) @map("coverage_status")
  /// Whether coverage was computed from the mapping or set by a person.
  /// The spec warns against pretending topic judgements are precise, so the
  /// screen has to be able to say which of the two a reader is looking at.
  coverageSource              Provenance     @default(SYSTEM_DERIVED) @map("coverage_source")
  /// A human judgement, presented as one. The spec is explicit that topic
  /// authority must not pretend to be scientifically precise.
  authorityStatus             TopicAuthority @default(UNKNOWN) @map("authority_status")
  ownerUserId                 String?        @map("owner_user_id") @db.Uuid
  /// The goal this topic serves. Stated, not inferred.
  businessGoalId              String?        @map("business_goal_id") @db.Uuid
  priority                    Int?
  status                      TenantStatus   @default(ACTIVE)
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")
  archivedAt                  DateTime?      @map("archived_at")

  website               Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  parentTopic           Topic?           @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  childTopics           Topic[]          @relation("TopicHierarchy")
  pillarPage            Page?            @relation("TopicPillarPage", fields: [pillarPageId], references: [id], onDelete: SetNull)
  commercialDestination Page?            @relation("TopicCommercialPage", fields: [commercialDestinationPageId], references: [id], onDelete: SetNull)
  owner                 User?            @relation("TopicOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  businessGoal          BusinessGoal?    @relation(fields: [businessGoalId], references: [id], onDelete: SetNull)
  topicKeywords         TopicKeyword[]
  topicPages            TopicPage[]
  opportunities         Opportunity[]
  recommendations       Recommendation[]

  @@unique([websiteId, slug])
  @@index([websiteId, coverageStatus])
  @@map("topic")
}

/// Many-to-many: a keyword can legitimately serve two topics.
model TopicKeyword {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  keywordId String   @map("keyword_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([topicId, keywordId])
  @@index([keywordId])
  @@map("topic_keyword")
}

model TopicPage {
  id        String        @id @default(uuid()) @db.Uuid
  topicId   String        @map("topic_id") @db.Uuid
  pageId    String        @map("page_id") @db.Uuid
  role      TopicPageRole @default(UNKNOWN)
  createdAt DateTime      @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([topicId, pageId])
  @@index([pageId])
  @@map("topic_page")
}

/// A third-party observation about somebody else's site.
///
/// Labelled as third-party everywhere it is displayed. The rule from the spec is
/// blunt and worth keeping blunt: do not present third-party estimates as
/// first-party truth.
model CompetitorKeywordSnapshot {
  id               String             @id @default(uuid()) @db.Uuid
  websiteId        String             @map("website_id") @db.Uuid
  competitorId     String             @map("competitor_id") @db.Uuid
  keywordId        String             @map("keyword_id") @db.Uuid
  capturedAt       DateTime           @map("captured_at") @db.Date
  position         Decimal?           @db.Decimal(7, 2)
  rankingUrl       String?            @map("ranking_url")
  sourceProvider   ConnectionProvider @map("source_provider")
  sourceSnapshotId String?            @map("source_snapshot_id") @db.Uuid
  sourceImportId   String?            @map("source_import_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")

  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  competitor     Competitor      @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  keyword        Keyword         @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  sourceSnapshot SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  sourceImport   Import?         @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([competitorId, keywordId, capturedAt, sourceProvider])
  @@index([websiteId, capturedAt])
  @@map("competitor_keyword_snapshot")
}

/// A file somebody uploaded, and everything that happened to it.
///
/// Nothing reaches a live table before a person has seen a preview, so the status
/// column is the actual state machine rather than a label.
model Import {
  id                String       @id @default(uuid()) @db.Uuid
  websiteId         String       @map("website_id") @db.Uuid
  source            ImportSource
  status            ImportStatus @default(UPLOADED)
  fileName          String       @map("file_name")
  /// Same file twice is the same import, which is what makes a retry safe.
  checksum          String
  byteSize          Int          @map("byte_size")
  rowCount          Int          @default(0) @map("row_count")
  validRowCount     Int          @default(0) @map("valid_row_count")
  invalidRowCount   Int          @default(0) @map("invalid_row_count")
  committedRowCount Int          @default(0) @map("committed_row_count")
  /// The raw file, retained so an import stays auditable after the fact. Capped;
  /// objectStorageKey is here for when file sizes outgrow a column.
  rawContent        String?      @map("raw_content")
  objectStorageKey  String?      @map("object_storage_key")
  capturedAt        DateTime?    @map("captured_at") @db.Date
  uploadedByUserId  String?      @map("uploaded_by_user_id") @db.Uuid
  startedAt         DateTime?    @map("started_at")
  finishedAt        DateTime?    @map("finished_at")
  errorCode         String?      @map("error_code")
  /// Our own sentence. Never the parser output, which can echo file content.
  errorSummary      String?      @map("error_summary")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  website             Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  uploadedBy          User?                       @relation("ImportUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  rows                ImportRow[]
  keywordMetrics      KeywordMetricsSnapshot[]
  rankingSnapshots    RankingSnapshot[]
  competitorSnapshots CompetitorKeywordSnapshot[]

  @@unique([websiteId, checksum])
  @@index([websiteId, createdAt])
  @@map("import")
}

/// One staged row, with whatever was wrong with it.
///
/// Exists so that surfacing invalid rows safely is a screen rather than a log
/// line. Values are held as text: coercion happens at validation, so a bad number
/// is a reportable row rather than a failed import.
model ImportRow {
  id          String   @id @default(uuid()) @db.Uuid
  importId    String   @map("import_id") @db.Uuid
  rowNumber   Int      @map("row_number")
  rawJson     Json     @map("raw_json")
  isValid     Boolean  @default(false) @map("is_valid")
  errorReason String?  @map("error_reason")
  createdAt   DateTime @default(now()) @map("created_at")

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, isValid])
  @@map("import_row")
}

/// Something worth doing, with the reasoning attached.
///
/// Identity is enforced by a raw unique index with NULLS NOT DISTINCT (migration
/// 20260903000200) so re-running detection updates rather than duplicates. A human
/// status is never overwritten by a re-run: somebody's judgement outranks a rule.
model Opportunity {
  id                        String              @id @default(uuid()) @db.Uuid
  websiteId                 String              @map("website_id") @db.Uuid
  type                      OpportunityType
  status                    OpportunityStatus   @default(IDENTIFIED)
  priority                  OpportunityPriority @default(LOW)
  title                     String
  summary                   String?
  pageId                    String?             @map("page_id") @db.Uuid
  keywordId                 String?             @map("keyword_id") @db.Uuid
  topicId                   String?             @map("topic_id") @db.Uuid
  competitorId              String?             @map("competitor_id") @db.Uuid
  businessGoalId            String?             @map("business_goal_id") @db.Uuid
  sourceSignalId            String?             @map("source_signal_id") @db.Uuid
  effort                    EffortLevel         @default(UNKNOWN)
  confidence                ConfidenceLevel     @default(UNKNOWN)
  businessImportance        Int?                @map("business_importance")
  /// Descriptive only. A numeric traffic or revenue forecast would be fabricated,
  /// and the spec forbids it outright.
  expectedEffectDescription String?             @map("expected_effect_description")
  /// 0–100. A prioritization heuristic, not a prediction.
  score                     Decimal?            @db.Decimal(6, 2)
  /// Every sub-score that produced `score`, so the number is reproducible from
  /// stored inputs months later. Untraceable priority scoring is a P2 FAIL.
  scoreInputsJson           Json?               @map("score_inputs_json")
  scoringModelVersion       String              @default("opportunity-scoring-v1") @map("scoring_model_version")
  ownerUserId               String?             @map("owner_user_id") @db.Uuid
  identifiedAt              DateTime            @default(now()) @map("identified_at")
  qualifiedAt               DateTime?           @map("qualified_at")
  scheduledAt               DateTime?           @map("scheduled_at")
  closedAt                  DateTime?           @map("closed_at")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  archivedAt                DateTime?           @map("archived_at")

  website      Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page         Page?                 @relation(fields: [pageId], references: [id], onDelete: SetNull)
  keyword      Keyword?              @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  topic        Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  competitor   Competitor?           @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  businessGoal BusinessGoal?         @relation(fields: [businessGoalId], references: [id], onDelete: SetNull)
  sourceSignal Signal?               @relation(fields: [sourceSignalId], references: [id], onDelete: SetNull)
  owner        User?                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  evidence     OpportunityEvidence[]

  // P3
  diagnosisRequests DiagnosisRequest[]
  diagnoses         Diagnosis[]
  recommendations   Recommendation[]

  @@index([websiteId, status, priority])
  @@index([websiteId, type])
  @@index([keywordId])
  @@map("opportunity")
}

/// What the opportunity was derived from. Every opportunity must be traceable.
model OpportunityEvidence {
  id               String              @id @default(uuid()) @db.Uuid
  opportunityId    String              @map("opportunity_id") @db.Uuid
  evidenceType     EvidenceType        @map("evidence_type")
  sourceEntityType String              @map("source_entity_type")
  sourceEntityId   String              @map("source_entity_id")
  metricKey        String              @map("metric_key")
  numericValue     Decimal?            @map("numeric_value") @db.Decimal(18, 4)
  textValue        String?             @map("text_value")
  capturedAt       DateTime?           @map("captured_at")
  periodStart      DateTime?           @map("period_start") @db.Date
  periodEnd        DateTime?           @map("period_end") @db.Date
  /// First-party or third-party, stated rather than implied.
  sourceProvider   ConnectionProvider? @map("source_provider")
  sourceSnapshotId String?             @map("source_snapshot_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_evidence")
}

// ---------------------------------------------------------------------------
// P3 — Evidence-based AI diagnosis and recommendations
// ---------------------------------------------------------------------------

enum AgentType {
  PAGE_DIAGNOSIS
}

enum AiTaskType {
  DIAGNOSE_PAGE
}

enum AiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PromptStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// What a piece of evidence is. Maps to the vocabulary in P3_SPEC §9.
enum EvidenceCategory {
  BUSINESS_CONTEXT
  BUSINESS_GOAL
  BRAND_FACT
  SEO_RULE
  GSC_METRIC
  GA4_METRIC
  KEYWORD_METRIC
  RANKING_SNAPSHOT
  KEYWORD_OWNERSHIP
  TOPIC_MAPPING
  COMPETITOR_OBSERVATION
  PAGE_CONTENT
  INTERNAL_LINK
  TECHNICAL_FINDING
  PREVIOUS_CHANGE
  PREVIOUS_DIAGNOSIS
  PREVIOUS_LEARNING
  MANUAL_VERIFICATION
}

/// How much weight a piece of evidence carries.
///
/// AI_INFERRED exists so that a conclusion drawn by a model can be recorded
/// without ever being presented as equivalent to something measured. P3_SPEC §10
/// is explicit about that, and the ordering here is the ordering on screen.
enum EvidenceReliability {
  DIRECT_FIRST_PARTY
  DIRECT_PROVIDER
  USER_PROVIDED
  SYSTEM_DERIVED
  AI_INFERRED
  UNKNOWN
}

enum DiagnosisRequestStatus {
  REQUESTED
  ASSEMBLING_EVIDENCE
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DiagnosisStatus {
  DRAFT
  AWAITING_REVIEW
  REVIEWED
  SUPERSEDED
  ARCHIVED
}

/// The taxonomy from P3_SPEC §16.
///
/// Three of these — the technical categories — will return UNKNOWN for the whole
/// of P3, because they need crawl evidence the product does not collect. That is
/// the correct answer rather than a gap, and naming the missing evidence is what
/// the agent is instructed to do instead of guessing.
enum DiagnosticCategory {
  INTENT_MISMATCH
  CTR_SERP_MISMATCH
  KEYWORD_OWNERSHIP_CONFLICT
  CANNIBALIZATION
  CONTENT_GAP
  CONTENT_STALENESS
  WEAK_INTERNAL_SUPPORT
  COMPETITOR_DISPLACEMENT
  TECHNICAL_INDEXATION
  TECHNICAL_RENDERING
  TECHNICAL_CANONICALIZATION
  SERP_FEATURE_CHANGE
  SEASONALITY
  CONVERSION_MISMATCH
  INSUFFICIENT_EVIDENCE
  OTHER
}

/// How strongly the evidence supports a finding.
///
/// CONFIRMED is reserved and enforced server-side: a finding with no supporting
/// evidence is downgraded whatever the model returned. UNKNOWN is a valid,
/// expected result rather than a failure to answer.
enum FindingVerdict {
  CONFIRMED
  STRONGLY_SUPPORTED
  SUSPECT
  CLEAR
  UNKNOWN
  NOT_APPLICABLE
}

enum EvidenceRelationship {
  SUPPORTS
  CONTRADICTS
  CONTEXT
}

enum RecommendationType {
  CONTENT_REFRESH
  CONTENT_CREATE
  TITLE_META_UPDATE
  INTENT_REALIGNMENT
  KEYWORD_OWNERSHIP_FIX
  INTERNAL_LINK_UPDATE
  PAGE_CONSOLIDATION
  PAGE_SPLIT
  TECHNICAL_INVESTIGATION
  TECHNICAL_FIX
  SERP_REVIEW
  CONVERSION_REVIEW
  MONITOR_ONLY
  REQUEST_MORE_EVIDENCE
  OTHER
}

/// P3 lifecycle only. The later states exist for P4 and are unreachable here,
/// because nothing in P3 executes anything.
enum RecommendationStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  MODIFIED
  REJECTED
  NEEDS_EVIDENCE
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum DecisionValue {
  APPROVED
  MODIFIED
  REJECTED
  NEEDS_EVIDENCE
}

enum ContentSource {
  MANUAL_PASTE
  UPLOAD
  FETCH
}

/// A versioned system prompt.
///
/// Editing an ACTIVE template is refused; a change creates a new version. The
/// alternative is a diagnosis whose prompt no longer exists, which is
/// unexplainable in exactly the way P2's scoring rule was written to prevent.
model PromptTemplate {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String
  agentType           AgentType    @map("agent_type")
  taskType            AiTaskType   @map("task_type")
  version             Int
  systemInstructions  String       @map("system_instructions")
  outputSchemaVersion String       @map("output_schema_version")
  status              PromptStatus @default(DRAFT)
  createdAt           DateTime     @default(now()) @map("created_at")
  activatedAt         DateTime?    @map("activated_at")
  retiredAt           DateTime?    @map("retired_at")

  runs AiRun[]

  @@unique([agentType, taskType, version])
  @@index([agentType, taskType, status])
  @@map("prompt_template")
}

/// What was asked of a model, and of whom.
///
/// Provider and model are recorded on every run so a diagnosis stays explicable
/// after either changes. Never holds a credential: P3_SPEC §7 says so and the
/// redaction denylist enforces it on the way to the audit trail.
model AiRun {
  id                    String      @id @default(uuid()) @db.Uuid
  organizationId        String      @map("organization_id") @db.Uuid
  workspaceId           String      @map("workspace_id") @db.Uuid
  websiteId             String      @map("website_id") @db.Uuid
  agentType             AgentType   @map("agent_type")
  taskType              AiTaskType  @map("task_type")
  provider              String
  model                 String
  promptTemplateId      String?     @map("prompt_template_id") @db.Uuid
  promptTemplateVersion Int?        @map("prompt_template_version")
  outputSchemaVersion   String      @map("output_schema_version")
  evidencePackageId     String?     @map("evidence_package_id") @db.Uuid
  status                AiRunStatus @default(QUEUED)
  startedAt             DateTime?   @map("started_at")
  finishedAt            DateTime?   @map("finished_at")
  inputTokens           Int?        @map("input_tokens")
  outputTokens          Int?        @map("output_tokens")
  estimatedCost         Decimal?    @map("estimated_cost") @db.Decimal(12, 6)
  /// A code from our own vocabulary. The provider's message can echo the request,
  /// which contains the evidence.
  errorCode             String?     @map("error_code")
  errorSummary          String?     @map("error_summary")
  createdByUserId       String?     @map("created_by_user_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website         Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  promptTemplate  PromptTemplate?  @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  evidencePackage EvidencePackage? @relation(fields: [evidencePackageId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("AiRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  diagnosisRequests DiagnosisRequest[]
  diagnoses         Diagnosis[]
  recommendations   Recommendation[]

  @@index([websiteId, createdAt])
  @@index([status])
  @@map("ai_run")
}

/// What gets retrieved, as data rather than as a constant.
///
/// P3_SPEC §13 requires the policy to be named, versioned and inspectable. A
/// constant in source is none of those from the outside, and a diagnosis has to
/// be re-readable against the rules that produced it.
model RetrievalPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  version     Int
  description String?
  /// The retrieval rules themselves, so a run records what it was told to gather.
  policyJson  Json     @map("policy_json")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  packages EvidencePackage[]

  @@unique([name, version])
  @@map("retrieval_policy")
}

/// The bounded, immutable set of evidence one AI run was given.
///
/// Immutable once its run completes. The content hash is over the frozen evidence
/// id list, so a package can be shown to be the same package later — which is what
/// makes a diagnosis reproducible rather than merely recorded.
model EvidencePackage {
  id                     String    @id @default(uuid()) @db.Uuid
  websiteId              String    @map("website_id") @db.Uuid
  targetType             String    @map("target_type")
  targetId               String    @map("target_id") @db.Uuid
  purpose                String
  assembledAt            DateTime  @default(now()) @map("assembled_at")
  contextVersionId       String?   @map("context_version_id") @db.Uuid
  periodStart            DateTime? @map("period_start") @db.Date
  periodEnd              DateTime? @map("period_end") @db.Date
  evidenceCount          Int       @default(0) @map("evidence_count")
  retrievalPolicyId      String?   @map("retrieval_policy_id") @db.Uuid
  retrievalPolicyVersion Int?      @map("retrieval_policy_version")
  /// What was gathered, and what was left out and why. Capping without disclosure
  /// would let a diagnosis be confidently wrong because the contradicting figure
  /// did not fit the budget.
  retrievalManifestJson  Json?     @map("retrieval_manifest_json")
  contentHash            String    @map("content_hash")
  /// Set when the run using this package finishes. Nothing may modify a sealed
  /// package.
  sealedAt               DateTime? @map("sealed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  website         Website                 @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  contextVersion  BusinessContextVersion? @relation(fields: [contextVersionId], references: [id], onDelete: SetNull)
  retrievalPolicy RetrievalPolicy?        @relation(fields: [retrievalPolicyId], references: [id], onDelete: SetNull)

  refs              EvidenceRef[]
  runs              AiRun[]
  diagnosisRequests DiagnosisRequest[]
  diagnoses         Diagnosis[]

  @@index([websiteId, assembledAt])
  @@index([websiteId, targetType, targetId])
  @@map("evidence_package")
}

/// One evidence id, frozen into a package.
///
/// This is the set a model-returned id is checked against. Storing the resolved
/// values alongside means a package can be re-read even after the underlying row
/// changes — and a difference between then and now is surfaced rather than hidden.
model EvidenceRef {
  id               String              @id @default(uuid()) @db.Uuid
  packageId        String              @map("package_id") @db.Uuid
  /// The deterministic identity from lib/evidence/id.
  evidenceId       String              @map("evidence_id")
  evidenceType     EvidenceCategory    @map("evidence_type")
  reliability      EvidenceReliability
  sourceEntityType String              @map("source_entity_type")
  sourceEntityId   String?             @map("source_entity_id")
  capturedAt       DateTime?           @map("captured_at")
  asOfDate         DateTime?           @map("as_of_date") @db.Date
  metricKey        String?             @map("metric_key")
  numericValue     Decimal?            @map("numeric_value") @db.Decimal(18, 4)
  textValue        String?             @map("text_value")
  contextJson      Json?               @map("context_json")
  createdAt        DateTime            @default(now()) @map("created_at")

  package EvidencePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, evidenceId])
  @@index([packageId, evidenceType])
  @@map("evidence_ref")
}

/// Somebody asked for a diagnosis, and what happened next.
model DiagnosisRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  websiteId         String                 @map("website_id") @db.Uuid
  targetType        String                 @map("target_type")
  targetId          String                 @map("target_id") @db.Uuid
  signalId          String?                @map("signal_id") @db.Uuid
  opportunityId     String?                @map("opportunity_id") @db.Uuid
  requestedByUserId String?                @map("requested_by_user_id") @db.Uuid
  status            DiagnosisRequestStatus @default(REQUESTED)
  evidencePackageId String?                @map("evidence_package_id") @db.Uuid
  aiRunId           String?                @map("ai_run_id") @db.Uuid
  errorCode         String?                @map("error_code")
  errorSummary      String?                @map("error_summary")
  createdAt         DateTime               @default(now()) @map("created_at")
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")

  website         Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  signal          Signal?          @relation(fields: [signalId], references: [id], onDelete: SetNull)
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  requestedBy     User?            @relation("DiagnosisRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  evidencePackage EvidencePackage? @relation(fields: [evidencePackageId], references: [id], onDelete: SetNull)
  aiRun           AiRun?           @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  diagnoses Diagnosis[]

  @@index([websiteId, createdAt])
  @@index([websiteId, status])
  @@map("diagnosis_request")
}

/// An answer, with everything needed to check it.
///
/// Never overwritten. A newer diagnosis supersedes an older one and both remain,
/// because what was believed at the time is part of the record — the same rule as
/// approved Business Context in P0.
model Diagnosis {
  id                String          @id @default(uuid()) @db.Uuid
  websiteId         String          @map("website_id") @db.Uuid
  requestId         String?         @map("request_id") @db.Uuid
  targetType        String          @map("target_type")
  targetId          String          @map("target_id") @db.Uuid
  signalId          String?         @map("signal_id") @db.Uuid
  opportunityId     String?         @map("opportunity_id") @db.Uuid
  status            DiagnosisStatus @default(DRAFT)
  executiveSummary  String          @map("executive_summary")
  primaryFindingId  String?         @map("primary_finding_id") @db.Uuid
  overallConfidence ConfidenceLevel @default(UNKNOWN) @map("overall_confidence")
  evidencePackageId String?         @map("evidence_package_id") @db.Uuid
  aiRunId           String?         @map("ai_run_id") @db.Uuid
  /// The diagnosis this one replaces, if any. History is a chain, not an edit.
  supersedesId      String?         @unique @map("supersedes_id") @db.Uuid
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  reviewedByUserId  String?         @map("reviewed_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  reviewedAt        DateTime?       @map("reviewed_at")
  archivedAt        DateTime?       @map("archived_at")

  website         Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  request         DiagnosisRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  signal          Signal?           @relation(fields: [signalId], references: [id], onDelete: SetNull)
  opportunity     Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  evidencePackage EvidencePackage?  @relation(fields: [evidencePackageId], references: [id], onDelete: SetNull)
  aiRun           AiRun?            @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  supersedes      Diagnosis?        @relation("DiagnosisHistory", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    Diagnosis?        @relation("DiagnosisHistory")
  createdBy       User?             @relation("DiagnosisCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy      User?             @relation("DiagnosisReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  findings        DiagnosisFinding[]
  recommendations Recommendation[]

  @@index([websiteId, createdAt])
  @@index([websiteId, targetType, targetId])
  @@map("diagnosis")
}

/// One assessed cause.
model DiagnosisFinding {
  id                         String             @id @default(uuid()) @db.Uuid
  diagnosisId                String             @map("diagnosis_id") @db.Uuid
  category                   DiagnosticCategory
  verdict                    FindingVerdict
  confidence                 ConfidenceLevel    @default(UNKNOWN)
  title                      String
  summary                    String
  supportingEvidenceCount    Int                @default(0) @map("supporting_evidence_count")
  contradictingEvidenceCount Int                @default(0) @map("contradicting_evidence_count")
  /// What would have to be known to say more. Given equal weight on screen: an
  /// unstated unknown becomes an assumption.
  missingEvidenceJson        Json?              @map("missing_evidence_json")
  /// Set when the server lowered the model's verdict, with the reason. The reader
  /// sees that it was changed rather than only the result.
  downgradedFrom             FindingVerdict?    @map("downgraded_from")
  downgradeReason            String?            @map("downgrade_reason")
  createdAt                  DateTime           @default(now()) @map("created_at")

  diagnosis Diagnosis                  @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  evidence  DiagnosisFindingEvidence[]

  @@unique([diagnosisId, category])
  @@index([diagnosisId])
  @@map("diagnosis_finding")
}

/// What a finding rests on, and what argues against it.
model DiagnosisFindingEvidence {
  id           String               @id @default(uuid()) @db.Uuid
  findingId    String               @map("finding_id") @db.Uuid
  /// The deterministic evidence id, validated against the sealed package.
  evidenceId   String               @map("evidence_id")
  relationship EvidenceRelationship
  createdAt    DateTime             @default(now()) @map("created_at")

  finding DiagnosisFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, evidenceId, relationship])
  @@index([findingId])
  @@map("diagnosis_finding_evidence")
}

/// Proposed work. P3 proposes; nothing in this phase executes.
model Recommendation {
  id                        String               @id @default(uuid()) @db.Uuid
  websiteId                 String               @map("website_id") @db.Uuid
  diagnosisId               String?              @map("diagnosis_id") @db.Uuid
  opportunityId             String?              @map("opportunity_id") @db.Uuid
  type                      RecommendationType
  status                    RecommendationStatus @default(AWAITING_REVIEW)
  priority                  OpportunityPriority  @default(MEDIUM)
  title                     String
  summary                   String
  rationale                 String
  pageId                    String?              @map("page_id") @db.Uuid
  keywordId                 String?              @map("keyword_id") @db.Uuid
  topicId                   String?              @map("topic_id") @db.Uuid
  /// Descriptive only. A numeric forecast is forbidden and has nowhere to live.
  expectedEffectDescription String?              @map("expected_effect_description")
  confidence                ConfidenceLevel      @default(UNKNOWN)
  effort                    EffortLevel          @default(UNKNOWN)
  risk                      RiskLevel            @default(UNKNOWN)
  /// Set when an active BLOCKING SEO Rule applies. Approval then requires an
  /// explicit override naming the rule and the person.
  blockedByRuleId           String?              @map("blocked_by_rule_id") @db.Uuid
  blockedReason             String?              @map("blocked_reason")
  ownerUserId               String?              @map("owner_user_id") @db.Uuid
  createdByAiRunId          String?              @map("created_by_ai_run_id") @db.Uuid
  createdByUserId           String?              @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  implementedAt             DateTime?            @map("implemented_at")
  archivedAt                DateTime?            @map("archived_at")

  website        Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  diagnosis      Diagnosis?   @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  page           Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  keyword        Keyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  topic          Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  blockedByRule  SeoRule?     @relation(fields: [blockedByRuleId], references: [id], onDelete: SetNull)
  owner          User?        @relation("RecommendationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdByAiRun AiRun?       @relation(fields: [createdByAiRunId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("RecommendationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  evidence  RecommendationEvidence[]
  decisions Decision[]

  @@index([websiteId, status])
  @@index([diagnosisId])
  @@map("recommendation")
}

/// What a recommendation cites. Without at least one, it is an opinion.
model RecommendationEvidence {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  evidenceId       String   @map("evidence_id")
  createdAt        DateTime @default(now()) @map("created_at")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, evidenceId])
  @@map("recommendation_evidence")
}

/// A person's decision on a recommendation.
///
/// decidedByUserId is a non-null foreign key to User, which is how "AI cannot
/// approve its own recommendation" is enforced: there is no column an AiRun could
/// occupy, so the rule holds in the schema rather than in a check somebody could
/// forget to write.
model Decision {
  id                         String        @id @default(uuid()) @db.Uuid
  websiteId                  String        @map("website_id") @db.Uuid
  recommendationId           String        @map("recommendation_id") @db.Uuid
  decision                   DecisionValue
  reason                     String?
  /// For MODIFIED: what the reviewer changed, kept as a diff rather than an
  /// overwrite, so the proposal and the decision both survive.
  modifiedRecommendationJson Json?         @map("modified_recommendation_json")
  /// Set when a reviewer approved despite a BLOCKING rule. Records the rule.
  overriddenRuleId           String?       @map("overridden_rule_id") @db.Uuid
  overrideReason             String?       @map("override_reason")
  decidedByUserId            String        @map("decided_by_user_id") @db.Uuid
  decidedAt                  DateTime      @default(now()) @map("decided_at")
  createdAt                  DateTime      @default(now()) @map("created_at")

  website        Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  overriddenRule SeoRule?       @relation("DecisionRuleOverride", fields: [overriddenRuleId], references: [id], onDelete: SetNull)
  decidedBy      User           @relation("DecisionMaker", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([websiteId, decidedAt])
  @@index([recommendationId])
  @@map("decision")
}

/// What a page said when it was diagnosed.
///
/// There is no crawler in SEO OS. Content arrives by paste, upload, or a
/// single-URL fetch through the sitemap fetcher's existing SSRF guards — never by
/// crawling, which is out of scope for every phase so far.
model PageContentSnapshot {
  id               String        @id @default(uuid()) @db.Uuid
  websiteId        String        @map("website_id") @db.Uuid
  pageId           String        @map("page_id") @db.Uuid
  capturedAt       DateTime      @default(now()) @map("captured_at")
  contentHash      String        @map("content_hash")
  title            String?
  metaDescription  String?       @map("meta_description")
  headingsJson     Json?         @map("headings_json")
  bodyText         String?       @map("body_text")
  wordCount        Int?          @map("word_count")
  source           ContentSource
  objectStorageKey String?       @map("object_storage_key")
  capturedByUserId String?       @map("captured_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  website    Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  capturedBy User?   @relation("ContentCapturer", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@unique([pageId, contentHash])
  @@index([websiteId, capturedAt])
  @@map("page_content_snapshot")
}
