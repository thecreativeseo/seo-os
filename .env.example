# ---------------------------------------------------------------------------
# SEO OS — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database (Prisma) ---
# Dev Supabase project, transaction pooler (6543). Used by the app at runtime.
DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Dev Supabase project, direct connection (5432). Used by migrations and the seed.
DIRECT_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# SECOND Supabase project, direct connection (5432). Used only by `prisma migrate dev`,
# which must create and drop a shadow database — managed Postgres will not allow that
# on the primary instance.
SHADOW_DATABASE_URL=postgresql://postgres.your-shadow-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional. No P0 code path reads this. It bypasses RLS and all auth, so it is
# deliberately left unwired: the app reaches Postgres through Prisma behind the
# server-side authorization guards.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# In P0 these lived only in the Supabase dashboard, because Supabase performed the
# sign-in exchange. P1 runs its own OAuth flow for Search Console and Analytics
# data access, so the application now reads them directly. The same client can be
# used, with the P1 redirect URIs added:
#   http://localhost:3000/api/connections/gsc/callback
#   http://localhost:3000/api/connections/ga4/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed (optional) ---
# Grants OWNER on the seeded organization to a user who has ALREADY signed in with
# Google. An explicit operator action naming one exact address — not domain matching.
# No login path in the application grants tenant access this way.
SEED_OWNER_EMAIL=

# --- Credential encryption (P1) ---
# Encrypts stored OAuth refresh tokens at rest (AES-256-GCM). Must decode to 32 bytes.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- AI provider (P3) ---
# P3 sends a bounded, hashed evidence package to a model and validates every claim
# it returns. Read from the environment only: the key never reaches a database row,
# an audit snapshot, or a prompt.
#
# Get one at https://console.anthropic.com → Billing (add credits first, the API is
# prepaid) → API Keys → Create Key. A Claude.ai Pro or Max subscription is a
# separate product and does not include API access.
#
# Leave this blank and P3 still works apart from running a model: evidence,
# packages, diagnosis history and human review all function, and the Diagnose
# action says plainly that no provider is configured rather than failing at the
# last step.
ANTHROPIC_API_KEY=

# Which model answers a diagnosis. Sonnet 5 is the default: the job is structured
# extraction over a bounded package, which it does well and cheaply. Opus 5 is
# available for harder cases.
#   claude-sonnet-5   (default)
#   claude-opus-5     (harder reasoning, higher cost)
AI_DIAGNOSIS_MODEL=claude-sonnet-5
