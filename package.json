{
  "name": "seo-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/server/jobs/worker.ts",
    "worker:dev": "tsx --env-file=.env.local src/server/jobs/worker.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:p1": "tsx prisma/seed-demo-p1.ts",
    "db:seed:demo:p2": "tsx prisma/seed-demo-p2.ts",
    "db:seed:demo:p3": "tsx prisma/seed-demo-p3.ts",
    "db:seed:demo:p4": "tsx prisma/seed-demo-p4.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
